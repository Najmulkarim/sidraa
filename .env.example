# Copy to .env.local for development. Never commit real values.

# Public by design — Row Level Security protects the data.
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. The secret key (sb_secret_...) or the legacy "service_role"
# key. Read only by src/lib/supabase/admin.ts, which starts with
# `import 'server-only'`. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# SERVER ONLY. Random string (32+ chars) used to hash IP addresses and
# phone numbers for rate limiting. Generate: openssl rand -hex 32
RATE_LIMIT_SALT=

# The public address of the shop, without a trailing slash. Used for
# canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Protects /api/cron/courier-sync (courier status safety net).
# Vercel Cron sends it automatically as "Authorization: Bearer <value>".
# Generate: openssl rand -hex 32
CRON_SECRET=

# Courier API keys and the Facebook Conversions API token are NOT env vars:
# a super admin enters them in Admin → Settings, and they are stored in
# tables that browsers can never read.
