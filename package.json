    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9",
    "vitest": "5.0.5"
  }
